{
  "name": "fastify-boilerplate",
  "version": "1.0.0",
  "description": "fastify-boilerplate",
  "main": "src/index.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git"
  },
  "dependencies": {
    "@fastify/env": "^5.0.3",
    "@fastify/redis": "^7.2.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/datastore": "^9.1.0",
    "@google-cloud/pubsub": "^5.2.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/storage": "^7.18.0",
    "@google-cloud/tasks": "^6.2.1",
    "@json2csv/plainjs": "^7.0.6",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.7.3",
    "dotenv": "^16.6.1",
    "env-schema": "^6.0.0",
    "fast-xml-parser": "^5.12.1",
    "fastify": "~5.6.2",
    "fastify-healthcheck": "^5.1.0",
    "fastify-metrics": "^12.1.0",
    "fastify-plugin": "^5.1.0",
    "http-status-codes": "^2.3.0",
    "knex": "^2.4.2",
    "moment-timezone": "^0.6.6",
    "node-cache": "^5.1.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=20.*"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "fs-extra": "^11.1.1",
    "husky": "^8.0.3",
    "inquirer": "^9.2.0",
    "jest": "^29.5.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^13.2.1",
    "nodemon": "^3.0.1",
    "pino-pretty": "^10.0.0",
    "prettier": "^2.8.8"
  },
  "eslintIgnore": [
    "node_modules/*",
    "coverage/*",
    ".nyc_output/*"
  ],
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "scripts": {
    "lint": "eslint . -c .eslintrc.json --ext js --fix",
    "lint:fix": "npm run lint -- --fix",
    "start:dev": "NODE_ENV=development nodemon -e js index | pino-pretty -c -t -l severity",
    "start": "node --max-http-header-size 24000 src/index",
    "test:unit": "LOG_LEVEL=silent jest -c jest.config.unit.js",
    "knex": "node -r dotenv/config ./node_modules/.bin/knex",
    "migrate:make": "npm run knex -- migrate:make --knexfile ./config/knexConfig.js",
    "migrate": "npm run knex -- migrate:latest --knexfile ./config/knexConfig.js",
    "migrate:down": "npm run knex -- migrate:down --knexfile ./config/knexConfig.js",
    "prepare": "husky install"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
