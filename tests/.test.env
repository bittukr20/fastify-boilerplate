# Configuration for the E2E tests. Loaded by tests/e2e/setupEnv.js and overrides any .env value.
# Points at an EXISTING PostgreSQL database named "test" (create it once: createdb test).
# The database name MUST be "test" or end with "_test": the tests refuse to run against any other database.
NODE_ENV=test
PORT=4001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_MIN_CONNECTION=2
DB_MAX_CONNECTION=10
# Rejected requests are logged as errors, which is noisy in tests. Use info or debug when debugging.
LOG_LEVEL=silent
# Silences the "injected env" notice that a dependency prints on every app start
DOTENV_CONFIG_QUIET=true
