NODE_ENV=development
PORT=4444
ENVIRONMENT=DEV
LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_IN_MS=25000
# Also log the request body in the response log line (it is always logged in the request line)
# LOG_REQUEST_BODY_IN_RESPONSE=false

# Database
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432

# Downstream systems
DOWNSTREAM_SYSTEM_URI=http://localhost:5000

# Google Cloud (optional locally, needed by the cloud plugins)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GCP_PROJECT_ID=my-gcp-project
# GCP_LOCATION=asia-south1
# CLOUD_TASKS_DEFAULT_QUEUE=default-queue
# CLOUD_BUCKET_NAME=my-bucket
# DATASTORE_NAMESPACE=my-namespace

# Redis (only for the opt-in redisCache plugin)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
